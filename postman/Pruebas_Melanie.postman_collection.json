      "name": "1. Autenticación (Tarea 28)",
      "item": [
        {
          "name": "01 Registro usuario A (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Correos únicos en cada ejecución para que la colección sea repetible",
                  "const t = Date.now();",
                  "pm.collectionVariables.set(\"correoA\", `usuario.a.${t}@prueba.com`);",
                  "pm.collectionVariables.set(\"correoB\", `usuario.b.${t}@prueba.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Devuelve el usuario creado con rol usuario\", () => {",
                  "  pm.expect(j.ok).to.eql(true);",
                  "  pm.expect(j.data).to.have.property(\"id\");",
                  "  pm.expect(j.data.correo).to.eql(pm.collectionVariables.get(\"correoA\"));",
                  "  pm.expect(j.data.rol).to.eql(\"usuario\");",
                  "});",
                  "pm.test(\"No devuelve contraseña ni hash\", () => {",
                  "  pm.expect(j.data).to.not.have.property(\"password\");",
                  "  pm.expect(j.data).to.not.have.property(\"password_hash\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario A\",\n  \"correo\": \"{{correoA}}\",\n  \"password\": \"{{passwordPrueba}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
