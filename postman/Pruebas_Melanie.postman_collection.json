        {
          "name": "07 Login usuario A (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Devuelve token JWT y usuario sin hash\", () => {",
                  "  pm.expect(j.data.token).to.be.a(\"string\");",
                  "  pm.expect(j.data.token.split(\".\")).to.have.lengthOf(3);",
                  "  pm.expect(j.data.usuario).to.not.have.property(\"password_hash\");",
                  "});",
                  "pm.test(\"El token tiene vencimiento (exp)\", () => {",
                  "  const payload = JSON.parse(atob(j.data.token.split(\".\")[1].replace(/-/g,\"+\").replace(/_/g,\"/\")));",
                  "  pm.expect(payload.exp).to.be.above(Math.floor(Date.now()/1000));",
                  "});",
                  "pm.environment.set(\"tokenA\", j.data.token);"
                ]
              }
            }
          ],
