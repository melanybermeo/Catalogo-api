                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "const p = j.data;",
                  "pm.test(\"Devuelve el producto creado con id\", () => {",
                  "  pm.expect(j.ok).to.eql(true);",
                  "  pm.expect(p.id).to.be.a(\"number\");",
                  "  pm.expect(p.nombre).to.eql(\"Parlante portátil Ola\");",
                  "  pm.expect(p.precio).to.eql(45.5);",
                  "});",
                  "pm.collectionVariables.set(\"productoCreadoId\", p.id);"
                ]
