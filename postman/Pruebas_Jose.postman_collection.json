      "name": "4. Productos (Tarea 30)",
      "item": [
        {
          "name": "P01 Listar catálogo sin token (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Devuelve una lista con al menos 5 productos\", () => {",
                  "  pm.expect(j.ok).to.eql(true);",
                  "  pm.expect(j.data).to.be.an(\"array\");",
                  "  pm.expect(j.data.length).to.be.at.least(5);",
                  "});",
                  "const p = j.data[0];",
                  "pm.test(\"Tiene todos los campos del producto\", () => {",
                  "  pm.expect(p).to.include.all.keys(\"id\", \"nombre\", \"descripcion\", \"categoria\", \"precio\");",
                  "  pm.expect(p.precio).to.be.a(\"number\");",
                  "});",
                  "pm.collectionVariables.set(\"productoSeedId\", j.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            }
          }
        },
        {
          "name": "P02 Filtrar por categoría hogar (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Solo devuelve productos de la categoría hogar\", () => {",
                  "  pm.expect(j.data.length).to.be.above(0);",
                  "  j.data.forEach(p => pm.expect(p.categoria.toLowerCase()).to.eql(\"hogar\"));",
                  "});"
