# Tarea 5 · Copiar este archivo como .env y completar los valores.
# Este archivo SÍ se sube al repo, por eso no lleva valores reales.

# Servidor
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=catalogo_api

# JWT (mínimo 32 caracteres). Generar uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Administrador (se crea con: npm run crear-admin)
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=
ADMIN_PASSWORD=
